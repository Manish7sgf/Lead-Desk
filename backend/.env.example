# MongoDB Atlas connection string (or local mongodb URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
DB_NAME=leaddesk_db

# Security & JWT Token secret
SECRET_KEY=supersecretjwtkey_change_in_production_123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Credentials (Seeded on server start if not present)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# CORS configuration (comma separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://lead-desk-ebon.vercel.app
